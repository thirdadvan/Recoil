MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1f114ebc380394945b7e1405ee82cc98, type: 3}
  m_Name: Cosplayer_ManagerGlasses
  m_EditorClassIdentifier: 
  lines:
  - role: 1
    speaker: The Disguised Man
    text: I did. Keep it down. His glasses are perfectly fine.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 2
    speaker: Dawn
    text: Why take them?
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 1
    speaker: The Disguised Man
    text: Ewa told me what that manager is like. I don't want him recognizing me.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 1
    speaker: The Disguised Man
    text: And I wanted to make his life a little harder.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 1
    speaker: The Disguised Man
    text: What, did he send you to get them back?
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices:
    - id: request
      label: Ask politely
      text: I'm looking for someone too. Please tell me where you put the glasses.
      offerPhoto: 0
      slidePhotoUnderDoor: 0
      continuation: {fileID: 0}
      response:
      - role: 1
        speaker: The Disguised Man
        text: You're looking for someone too? ...All right. Don't tell him I told
          you.
        offerPhoto: 0
        slidePhotoUnderDoor: 0
    - id: demand
      label: Demand answers
      text: Settle your grudge with him later. Where are the glasses? Tell me now.
      offerPhoto: 0
      slidePhotoUnderDoor: 0
      continuation: {fileID: 0}
      response:
      - role: 1
        speaker: The Disguised Man
        text: You like giving orders, don't you? ...Fine. They're no use to me anyway.
        offerPhoto: 0
        slidePhotoUnderDoor: 0
    - id: intimidate
      label: Threaten exposure
      text: Tell me where the glasses are, and I won't expose you to the manager.
      offerPhoto: 0
      slidePhotoUnderDoor: 0
      continuation: {fileID: 0}
      response:
      - role: 1
        speaker: The Disguised Man
        text: ...Keep your voice down. I'll tell you. Just leave her out of this.
        offerPhoto: 0
        slidePhotoUnderDoor: 0
  - role: 1
    speaker: The Disguised Man
    text: The warehouse roof. I threw them up there.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: manager_glasses_roof_known
    choices: []
  - role: 2
    speaker: Dawn
    text: The warehouse roof... I'll take a look.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 1
    speaker: The Disguised Man
    text: Take them and go. And don't mention me to the manager.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
