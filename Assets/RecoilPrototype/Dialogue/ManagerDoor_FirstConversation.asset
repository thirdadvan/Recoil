  m_Script: {fileID: 11500000, guid: 1f114ebc380394945b7e1405ee82cc98, type: 3}
  m_Name: ManagerDoor_FirstConversation
  m_EditorClassIdentifier: 
  lines:
  - role: 1
    speaker: The Manager
    text: Who... who's out there?
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices:
    - id: manager_ask
      label: Find someone
      text: I'm looking for someone.
      offerPhoto: 0
      slidePhotoUnderDoor: 0
      continuation: {fileID: 11400000, guid: 7cb60c5b428d949e8882e999578c1cdc, type: 2}
      response:
      - role: 1
        speaker: The Manager
        text: I'm sorry. It's just me in here. There's no one else.
        offerPhoto: 0
        slidePhotoUnderDoor: 0
      - role: 2
        speaker: Dawn
        text: If you open the door, we can talk properly.
        offerPhoto: 0
        slidePhotoUnderDoor: 0
    - id: manager_silence
      label: Remain silent
      text: (Silence.)
      offerPhoto: 0
      slidePhotoUnderDoor: 0
      continuation: {fileID: 11400000, guid: 8ab2609c8e3bb4a9ebe6855b024efa5e, type: 2}
      response:
      - role: 1
        speaker: The Manager
        text: Ah... don't come any closer!
        offerPhoto: 0
        slidePhotoUnderDoor: 0
      - role: 2
        speaker: Dawn
        text: (Silence.)
        offerPhoto: 0
        slidePhotoUnderDoor: 0
      - role: 1
        speaker: The Manager
        text: Ah... where did I put my bat?
        offerPhoto: 0
        slidePhotoUnderDoor: 0
      - role: 2
        speaker: Dawn
        text: (Silence.)
        offerPhoto: 0
        slidePhotoUnderDoor: 0
