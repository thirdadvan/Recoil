%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1f114ebc380394945b7e1405ee82cc98, type: 3}
  m_Name: ManagerAneta_AdmissionRequest
  m_EditorClassIdentifier: 
  lines:
  - role: 2
    speaker: Dawn
    text: I found Aneta's electronic employment record. She worked here.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 1
    speaker: The Manager
    text: ...I'm sorry. I was frightened.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 2
    speaker: Dawn
    text: So you do know her.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 1
    speaker: The Manager
    text: Yes. Please, keep your voice down. I don't want anyone hearing this.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 2
    speaker: Dawn
    text: Tell me what happened to her.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 1
    speaker: The Manager
    text: I will. I promise. But could you help me first?
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 2
    speaker: Dawn
    text: With what?
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 1
    speaker: The Manager
    text: The freight lift has no power. The warehouse is full of cargo.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 1
    speaker: The Manager
    text: The government is coming for another shipment. If it isn't ready, they'll
      blame me.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 2
    speaker: Dawn
    text: You can tell me about Aneta now.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 1
    speaker: The Manager
    text: Please... I can barely think. Just help me get through this first.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 1
    speaker: The Manager
    text: The power panel is in the warehouse storage room. Here. Take the key.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 1
    speaker: The Manager
    text: There's no one else I can ask.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 2
    speaker: Dawn
    text: I'll restore the power. Then you answer my questions.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 1
    speaker: The Manager
    text: Thank you. I knew you wouldn't leave me like this.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
