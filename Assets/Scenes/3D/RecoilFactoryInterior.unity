  m_Name: 
  m_EditorClassIdentifier: 
  displayName: "Guard rota \u2014 26 October 1978"
  interactionPrompt: E / READ NOTE
  interactionRange: 0.5
  pageImage: {fileID: 2800000, guid: e4f47ad3d7fc74636a3b8d9de77c1a88, type: 3}
  pageMesh: {fileID: 0}
  pageDisplayScale: 1
  pageText: '26 OCTOBER 1978


    Two at the left entrance. Change at the bell.

    Keep
    a passage clear for the wounded.

    Do not move the bedding back into the wash
    bay.


    [The bottom of the page is stained and torn.]'
  readProgressFlag: 
  disappearAfterReading: 0
  worldVisual: {fileID: 0}
