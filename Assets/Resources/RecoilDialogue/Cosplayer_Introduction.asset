  lines:
  - role: 2
    speaker: Dawn
    text: What are you doing here?
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 1
    speaker: The Disguised Man
    text: I'm looking for my girlfriend.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 2
    speaker: Dawn
    text: What's her name?
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 1
    speaker: The Disguised Man
    text: Ewa. I love her. I have to find her.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: cosplayer_girlfriend_ewa_known
    choices: []
  - role: 1
    speaker: The Disguised Man
    text: She came to work at this factory. I haven't heard from her since.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
  - role: 1
    speaker: The Disguised Man
    text: If you hear anything about her, please tell me.
    offerPhoto: 0
    slidePhotoUnderDoor: 0
    progressFlag: 
    choices: []
